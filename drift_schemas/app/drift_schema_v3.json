  "fixed_sql": [
    {
      "name": "players",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"players\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"name_key\" TEXT NOT NULL UNIQUE, \"avatar_json\" TEXT NOT NULL, \"favorite_seat\" INTEGER NULL, \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "game_settings_last",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"game_settings_last\" (\"game_id\" TEXT NOT NULL, \"config_json\" TEXT NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"game_id\"));"
        }
      ]
    },
    {
      "name": "saved_sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"saved_sessions\" (\"game_id\" TEXT NOT NULL, \"save_json\" TEXT NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"game_id\"));"
        }
      ]
    },
    {
      "name": "matches",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"matches\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"game_id\" TEXT NOT NULL, \"played_at\" INTEGER NOT NULL, \"duration_ms\" INTEGER NOT NULL, \"difficulty\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "match_participants",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"match_participants\" (\"match_id\" INTEGER NOT NULL REFERENCES matches (id) ON DELETE CASCADE, \"seat\" INTEGER NOT NULL, \"player_id\" INTEGER NULL REFERENCES players (id) ON DELETE SET NULL, \"robot\" INTEGER NOT NULL CHECK (\"robot\" IN (0, 1)), \"place\" INTEGER NOT NULL, \"score\" INTEGER NOT NULL, \"stars\" INTEGER NOT NULL, PRIMARY KEY (\"match_id\", \"seat\"));"
        }
      ]
    },
    {
      "name": "player_counters",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"player_counters\" (\"player_id\" INTEGER NOT NULL REFERENCES players (id) ON DELETE CASCADE, \"key\" TEXT NOT NULL, \"value\" INTEGER NOT NULL, PRIMARY KEY (\"player_id\", \"key\"));"
        }
      ]
    },
    {
      "name": "earned_badges",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"earned_badges\" (\"player_id\" INTEGER NOT NULL REFERENCES players (id) ON DELETE CASCADE, \"badge_id\" TEXT NOT NULL, \"earned_at\" INTEGER NOT NULL, PRIMARY KEY (\"player_id\", \"badge_id\"));"
        }
      ]
    }
